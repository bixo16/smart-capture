{
  "name": "smart-capture",
  "productName": "Smart Capture",
  "version": "1.0.0",
  "description": "Captura e gravação de regiões do ecrã para Windows",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test src/main/ffmpeg-args.test.ts",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.smartcapture.app",
    "productName": "Smart Capture",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
